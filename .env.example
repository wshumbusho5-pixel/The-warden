# API Keys
ANTHROPIC_API_KEY=your-claude-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8765

# Client Configuration
# Update this with your main computer's IP address
MAIN_COMPUTER_IP=192.168.1.100

# Full server URL (takes precedence over MAIN_COMPUTER_IP/SERVER_PORT).
# Use this when hosting behind a reverse proxy with TLS.
# WARDEN_SERVER_URL=wss://warden.example.com

# Shared bearer token. Set the SAME value on the server and every client.
# If unset, the server accepts any connection — fine for localhost,
# NOT safe to expose publicly. Generate with: openssl rand -hex 32
# WARDEN_AUTH_TOKEN=

# Set to 1 on headless server deploys to skip the Tk window (no display).
# WARDEN_NO_DISPLAY=1

# --- Stripe self-serve billing (server-side, Phase 3) ---
# Set these on the server to enable the billing service (billing_server.py).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# WARDEN_PUBLIC_URL=https://warden.example.com
# WARDEN_WSS_URL=wss://warden.example.com
# WARDEN_SUB_USAGE_LIMIT=3500
# BILLING_PORT=8766
